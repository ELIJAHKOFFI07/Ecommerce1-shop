// DreamShop — schéma Postgres.
//
// Un e-commerce classique : catalogue public, panier, commande avec
// adresse de livraison, paiement à la livraison ou par Mobile Money
// (confirmé par l'admin), stock simple décrémenté à la confirmation.
// Sécurité : RateLimit, AuditLog, verrouillage de compte.
// Toute valeur monétaire est Decimal(15,2).

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Comptes & sécurité ─────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  STOCK_MANAGER
  SUPPORT
  CLIENT
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  role              Role      @default(CLIENT)
  blocked           Boolean   @default(false)
  phone             String?
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts            Account[]
  permissions         UserPermission[]
  addresses           Address[]
  orders              Order[]
  stockMovements      StockMovement[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@index([role])
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  target    String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Module {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  name        String
  description String?
  permissions UserPermission[]
}

model UserPermission {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @db.Uuid
  moduleId String  @db.Uuid
  canView  Boolean @default(false)
  canEdit  Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

// ───────────────────────── Catalogue ─────────────────────────

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  image     String?
  position  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// `compareAtPrice` : ancien prix barré (promotion). `stock` : unités
/// disponibles à la vente, décrémentées à la CONFIRMATION d'une commande,
/// restituées à l'annulation d'une commande confirmée.
model Product {
  id             String   @id @default(uuid()) @db.Uuid
  sku            String   @unique
  title          String
  slug           String   @unique
  description    String?
  price          Decimal  @db.Decimal(15, 2)
  compareAtPrice Decimal? @db.Decimal(15, 2)
  images         String[] @default([])
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  stock          Int      @default(0)
  lowStockAlert  Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categories     Category[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([active])
  @@index([featured])
}

enum StockMovementReason {
  RECEPTION
  SALE
  RETURN
  ADJUSTMENT
  LOSS
}

model StockMovement {
  id        String              @id @default(uuid()) @db.Uuid
  productId String              @db.Uuid
  quantity  Int
  reason    StockMovementReason
  note      String?
  userId    String?             @db.Uuid
  createdAt DateTime            @default(now())
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
}

// ───────────────────────── Commandes ─────────────────────────

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  label     String   @default("Domicile")
  fullName  String
  phone     String
  city      String
  commune   String?
  details   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  MOBILE_MONEY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

/// L'adresse est COPIÉE dans la commande : modifier son carnet
/// d'adresses ne réécrit pas une commande passée.
model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique
  userId          String        @db.Uuid
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentRef      String?
  subTotal        Decimal       @db.Decimal(15, 2)
  shippingFee     Decimal       @default(0) @db.Decimal(15, 2)
  total           Decimal       @db.Decimal(15, 2)
  shipFullName    String
  shipPhone       String
  shipCity        String
  shipCommune     String?
  shipDetails     String
  note            String?
  cancelReason    String?
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @db.Uuid
  productId  String  @db.Uuid
  title      String
  image      String?
  quantity   Int
  unitPrice  Decimal @db.Decimal(15, 2)
  totalPrice Decimal @db.Decimal(15, 2)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ───────────────────────── Paramètres ─────────────────────────

model Settings {
  id                    Int      @id @default(1)
  siteName              String   @default("DreamShop")
  siteEmail             String?
  sitePhone             String?
  siteAddress           String?
  currency              String   @default("FCFA")
  shippingFee           Decimal  @default(0) @db.Decimal(15, 2)
  freeShippingThreshold Decimal? @db.Decimal(15, 2)
  mobileMoneyNumber     String?
  mobileMoneyName       String?
  updatedAt             DateTime @updatedAt
}
