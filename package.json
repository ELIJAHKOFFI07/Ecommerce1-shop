    "postinstall": "prisma generate",
    "db:seed:test": "tsx prisma/seed-test.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@imagekit/nodejs": "^7.0.0",
    "@prisma/adapter-pg": "7.10.0",
