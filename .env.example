# Copie ce fichier en .env.local et remplis les valeurs.
# Ces mêmes variables doivent être renseignées dans Vercel
# (voir DEPLOIEMENT_VERCEL.md).

# --- Backend actif ---------------------------------------------------------
# "supabase" (historique), "parse" (abandonné, voir PARSE_MIGRATION.md) ou
# "nextjs" (direction actuelle — Postgres auto-hébergé + Route Handlers,
# voir NEXTJS_BACKEND_MIGRATION.md).
NEXT_PUBLIC_BACKEND_PROVIDER=nextjs

# --- Backend Next.js + Postgres (direction actuelle) ------------------------
# postgres-app/README.md explique comment obtenir cette URL depuis le VPS.
DATABASE_URL=postgresql://user:password@localhost:5432/dreamteamshop

# Auth.js — génération : npx auth secret (ou openssl rand -base64 32)
AUTH_SECRET=
# Google Cloud Console > API et services > Identifiants > ID client OAuth
# (type Application Web). URI de redirection autorisé :
#   https://votre-domaine/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Supabase (backend actif) ---------------------------------------------
# Tableau de bord Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète — JAMAIS préfixée NEXT_PUBLIC_, sinon elle serait exposée dans
# le navigateur et donnerait un accès total à la base.
# Utilisée uniquement par les routes serveur /api/admin/* pour créer, modifier
# ou supprimer un compte et réinitialiser un mot de passe (auth.users est
# inaccessible avec la clé anon).
# Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Firebase Cloud Messaging (notifications push) -------------------------
# Publiques : injectées dans le navigateur, sans risque.
# Console Firebase > Paramètres du projet > Général (les 4 premières)
# et Cloud Messaging > Certificats push Web (la clé VAPID).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
#
# Le compte de service (fichier JSON) n'est PAS une variable Vercel : il vit
# côté Supabase, posé par
#   npx supabase secrets set FIREBASE_SERVICE_ACCOUNT="$(cat le-fichier.json)"

# --- Parse Server (pas encore actif, voir backend-parse-wip/README.md) -----
# NEXT_PUBLIC_PARSE_APP_ID=
# NEXT_PUBLIC_PARSE_JS_KEY=
# NEXT_PUBLIC_PARSE_SERVER_URL=
# PARSE_MASTER_KEY=
