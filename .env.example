# ───────────────────────────────────────────────────────────────────────
# DreamShop — variables d'environnement
#
# Copiez ce fichier en `.env` (jamais commité) et remplissez les valeurs.
# Sur Vercel : Settings → Environment Variables → Import .env.
# Aucune valeur réelle ne doit JAMAIS apparaître dans un fichier suivi par git.
# ───────────────────────────────────────────────────────────────────────

# Base de données Postgres (VPS). Voir docs/VPS.md.
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/BASE?sslmode=require
# Le mot de passe doit être encodé (ex. : + devient %2B).
DATABASE_URL=postgresql://dreamshopshop:CHANGEZ_MOI@72.62.31.97:5432/dreamshopshop?sslmode=require

# Auth.js — clé de signature des sessions. Générez-la :  openssl rand -base64 32
AUTH_SECRET=CHANGEZ_MOI_32_CARACTERES_MINIMUM
# URL publique de l'app (sans / final)
AUTH_URL=https://votre-domaine.vercel.app
NEXT_PUBLIC_APP_URL=https://votre-domaine.vercel.app

# Google — connexion des comptes existants uniquement. Voir docs/SERVICES.md §1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImageKit — photos produits, reçus, preuves. Voir docs/SERVICES.md §2
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER=DreamShop

# Gmail SMTP — e-mails transactionnels. Voir docs/SERVICES.md §3
# Sans ces deux valeurs, les e-mails sont affichés en console (mode dev).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Amorçage (npm run db:seed) — premier super-administrateur.
# SEED_ADMIN_PASSWORD facultatif : sinon un mot de passe est généré et affiché une fois.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
