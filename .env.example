# Copie ce fichier en .env.local et remplis les valeurs.
# Ces mêmes variables doivent être renseignées dans Vercel
# (voir DEPLOIEMENT_VERCEL.md).

# --- Backend actif ---------------------------------------------------------
# "supabase" (défaut, actuel) ou "parse" (quand le VPS Parse sera prêt).
NEXT_PUBLIC_BACKEND_PROVIDER=supabase

# --- Supabase (backend actif) ---------------------------------------------
# Tableau de bord Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Parse Server (pas encore actif, voir backend-parse-wip/README.md) -----
# NEXT_PUBLIC_PARSE_APP_ID=
# NEXT_PUBLIC_PARSE_JS_KEY=
# NEXT_PUBLIC_PARSE_SERVER_URL=
# PARSE_MASTER_KEY=
