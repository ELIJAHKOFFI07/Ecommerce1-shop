# Copier en .env sur le VPS, puis remplir. Ce fichier-ci ne contient aucune
# valeur réelle et reste versionné ; .env ne doit jamais l'être.

# --- Base ---
PG_USER=parse
PG_PASSWORD=            # openssl rand -base64 32
PG_DATABASE=dreamteamshop

# --- Parse ---
PARSE_APP_ID=dreamteamshop
# La master key contourne CLP et ACL, comme le service_role de Supabase.
# Elle ne doit exister que sur le VPS : jamais dans le dépôt, jamais dans une
# variable préfixée NEXT_PUBLIC_.
PARSE_MASTER_KEY=       # openssl rand -base64 48
PARSE_JS_KEY=           # openssl rand -base64 32
PARSE_PUBLIC_URL=https://api.exemple.ci/parse

# --- Dashboard ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- E-mail (remplace l'Edge Function send-notification-email) ---
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=          # mot de passe d'application Gmail, pas le mot de passe du compte

# --- Push FCM (remplace send-push-notification) ---
# Le JSON du compte de service, sur une seule ligne.
FIREBASE_SERVICE_ACCOUNT=
